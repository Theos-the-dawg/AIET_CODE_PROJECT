<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> | Gadget House</title>
</head>
<body>
  <header>
    <h1>Gadget House</h1>
    <nav>
      <a href="/home">Home</a> |
      <a href="/products">Products</a> |
      <a href="/orders/mine">My Orders</a> |
      <a href="/invoices">My Invoices</a> |
      <a href="/logout">Logout</a>
    </nav>
  </header>

  <main>
    <h2><%= title %></h2>

    <% if (invoices && invoices.length) { %>
      <table border="1" cellspacing="0" cellpadding="8">
        <thead>
          <tr>
            <th>Invoice #</th>
            <th>Product</th>
            <th>Quantity</th>
            <th>Total</th>
            <th>Status</th>
            <th>Issued</th>
          </tr>
        </thead>
        <tbody>
          <% invoices.forEach(invoice => { %>
            <tr>
              <td><%= invoice.invoiceNumber %></td>
              <td><%= invoice.product ? invoice.product.name : 'Unknown product' %></td>
              <td><%= invoice.quantity %></td>
              <td>$<%= invoice.totalPrice.toFixed(2) %></td>
              <td><%= invoice.status %></td>
              <td><%= new Date(invoice.createdAt).toLocaleString() %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } else { %>
      <p>You have not generated any invoices yet.</p>
    <% } %>

    <p><a href="/home">Back to Home</a></p>
  </main>
</body>
</html>