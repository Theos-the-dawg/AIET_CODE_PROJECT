<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | Gadget House</title>
</head>
<body>
  <h1>Contact Us</h1>

  <% if (submitted) { %>
    <p>Thanks <strong><%= formData.name %></strong>, your message has been received.</p>
    <p>We will reply to <%= formData.email %>.</p>
  <% } else { %>
    <% if (error) { %>
      <p style="color: red;"><%= error %></p>
    <% } %>
    <form action="/contact" method="POST">
      <div>
        <label for="name">Name</label>
        <input id="name" type="text" name="name" value="<%= formData.name || '' %>" required>
      </div>
      <div>
        <label for="email">Email</label>
        <input id="email" type="email" name="email" value="<%= formData.email || '' %>" required>
      </div>
      <div>
        <label for="message">Message</label>
        <textarea id="message" name="message" rows="4" required><%= formData.message || '' %></textarea>
      </div>
      <button type="submit">Send</button>
    </form>
  <% } %>

  <a href="/home">Back Home</a>
</body>
</html>
