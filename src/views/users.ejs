<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Users | Gadget House</title>
</head>
<body>
  <h1>Registered Users</h1>
  <% if (users && users.length) { %>
    <ul>
      <% users.forEach(user => { %>
        <li><strong><%= user.username %></strong> — <%= user.email %></li>
      <% }) %>
    </ul>
  <% } else { %>
    <p>No users found.</p>
  <% } %>
  <a href="/home">Back Home</a>
</body>
</html>