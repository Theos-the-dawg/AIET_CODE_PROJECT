<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> |Gadget House</title>
</head>
<body>
  <header>
    <h1>Contact Us</h1>
    <nav>
      <a href="/home">Home</a> |
      <a href="/about">About</a> |
      <a href="/services">Services</a> |
      <a href="/contact">Contact</a> |
      <a href="/logout">Logout</a>
    </nav>
  </header>
  <main>
    <h2>Get in touch</h2>
    <p>Have a question about products or orders? Send us a message and we’ll respond quickly.</p>
    <% if (submitted) { %>
      <p><strong>Thanks, <%= userName %>!</strong> Your message was sent successfully.</p>
    <% } else { }%>
      <% if (error) { %>
        <p style="color:red;"><%= error %></p>
      <% } %>
      <form action="/contact" method="post">
        <div>
          <label for="name">Name</label><br>
          <input type="text" id="name" name="name" required>
        </div>
        <div>
          <label for="email">Email</label><br>
          <input type="email" id="email" name="email" required>
        </div>
        <div>
          <label for="message">Message</label><br>
          <textarea id="message" name="message" rows="5" required></textarea>
        </div>
        <div>
          <button type="submit">Send Message</button>
        </div>
      </form>
   
  </main>
  <footer>
    <p>&copy; <%= new Date().getFullYear() %> Gadget House</p>
  </footer>
</body>
</html>
