<!DOCTYPE html>
<html>
<head>
    <title><%= title %></title>
</head>
<body>
    <h1>Available Gadgets</h1>
    <ul>
        <% productList.forEach(product => { %>
            <li>
                <strong><%= product.name %></strong> - $<%= product.price %> 
                (ID: <%= product.id %>)
            </li>
        <% }); %>
    </ul>
    <a href="/">Back Home</a>
</body>
</html>